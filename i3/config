# ===========================================================
# i3 Configuration File
# ===========================================================
# Generated originally by i3-config-wizard, then improved manually.
# Docs: https://i3wm.org/docs/userguide.html
# ===========================================================

# ------------------------
# Appearance
# ------------------------
for_window [class="^.*"] border pixel 1
hide_edge_borders smart
font pango:monospace 11

# ------------------------
# Mod Key
# ------------------------
set $mod Mod4

# ------------------------
# Startup Programs
# ------------------------
# Start XDG autostart .desktop files
exec --no-startup-id dex --autostart --environment i3

# Screen lock before suspend
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork
# Network Manager Applet
exec --no-startup-id nm-applet

# Notifications (Dunst)
exec_always --no-startup-id dunst

# Compositor (Picom)
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf

# Wallpaper
exec_always --no-startup-id feh --bg-fill ~/Pictures/wallpapers/1234.jpg

#Keyboard layout
exec_always --no-startup-id setxkbmap fr_custom custom

# ------------------------
# Volume & Sound
# ------------------------
set $refresh_i3status killall -SIGUSR1 i3blocks
#bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
#bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
#bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
#bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status



# ------------------------
# Mouse & Floating Windows
# ------------------------
floating_modifier $mod
tiling_drag modifier titlebar

# ------------------------
# Basic Keybindings
# ------------------------
# Terminal
bindsym $mod+Return exec kitty

# Kill focused window
bindsym $mod+q kill

# App launcher
# Alternative: rofi
#bindsym $mod+d exec --no-startup-id dmenu_run
bindsym $mod+d exec "rofi -modi drun,run -show drun"
#Browser
bindsym $mod+b exec --no-startup-id firefox
#vscode
bindsym $mod+p exec --no-startup-id code
#clipboard manager
exec --no-startup-id copyq
bindsym $mod+c exec --no-startup-id copyq toggle
#thunar
bindsym $mod+t exec --no-startup-id dolphin
#spotify
bindsym $mod+m exec --no-startup-id spotify
# ------------------------
# Focus movement
# ------------------------
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# ------------------------
# Move windows
# ------------------------
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# ------------------------
# Layouts and modes
# ------------------------
#bindsym $mod+Shift+h split h
#bindsym $mod+Shift+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+z layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# ------------------------
# Workspaces
# ------------------------
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Switch to workspace
bindsym $mod+ampersand workspace number $ws1
bindsym $mod+eacute workspace number $ws2
bindsym $mod+quotedbl workspace number $ws3
bindsym $mod+apostrophe workspace number $ws4
bindsym $mod+parenleft workspace number $ws5
bindsym $mod+minus workspace number $ws6
bindsym $mod+egrave workspace number $ws7
bindsym $mod+underscore workspace number $ws8
bindsym $mod+ccedilla workspace number $ws9
bindsym $mod+agrave workspace number $ws10

# Move focused container to workspace
bindsym $mod+Shift+ampersand move container to workspace number $ws1
bindsym $mod+Shift+eacute move container to workspace number $ws2
bindsym $mod+Shift+quotedbl move container to workspace number $ws3
bindsym $mod+Shift+apostrophe move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+minus move container to workspace number $ws6
bindsym $mod+Shift+egrave move container to workspace number $ws7
bindsym $mod+Shift+underscore move container to workspace number $ws8
bindsym $mod+Shift+ccedilla move container to workspace number $ws9
bindsym $mod+Shift+agrave move container to workspace number $ws10

# ------------------------
# System actions
# ------------------------
# Reload config
bindsym $mod+Shift+c reload
# Restart i3 (preserves layout/session)
bindsym $mod+Shift+r restart
# Exit i3
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3 session?' -B 'Yes, exit i3' 'i3-msg exit'"

# ------------------------
# Resize Mode
# ------------------------
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt

    bindsym Right resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Left resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# ------------------------
#i3bar
# ------------------------
#bar {
#    status_command i3status
#}

bar {
    status_command i3blocks
    position top
    
    colors {
        background #120e08
        statusline #d1b994
        separator  #655030
        
        # class            border    backgr.   text
        focused_workspace  #8c734e   #2a2012   #d1b994
        active_workspace   #655030   #1b140a   #b3976d
        inactive_workspace #231b0e   #120e08   #655030
        binding_mode       #b3976d   #2a2012   #d1b994
    }
}


